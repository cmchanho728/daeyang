---
import ProductLinkPanel from "./ProductLinkPanel.astro";
import ContactActions from "./ContactActions.astro";
import { categoryMetas } from "../data/products";
import { baseUrl as base } from "../utils/url";

const publishedByGroup = (group: "vacuum" | "fuel") =>
  categoryMetas
    .filter((c) => c.published && c.group === group)
    .sort((a, b) => a.order - b.order)
    .map((c) => ({ title: c.title, desc: c.summary, href: `${base}products/${c.key}/` }));

const vacuumBanner = Astro.props.vacuumBanner ?? `${base}products-vctruck.jpg`;
const fuelBanner = Astro.props.fuelBanner ?? `${base}products-tltruck.jpg`;

const showTitle = Astro.props.showTitle ?? true;
const titleText = Astro.props.titleText ?? "제품소개";
const subtitleText =
  Astro.props.subtitleText ?? "분뇨차·유조차 주요 부품을 카테고리별로 안내합니다.";

const vacuumCards = publishedByGroup("vacuum");
const fuelCards = publishedByGroup("fuel");

const showActions = Astro.props.showActions ?? false;
const showLinkPanel = Astro.props.showLinkPanel ?? false;
---

<section class="wrap">
  <div class="container">
    {showTitle && (
      <>
        <h2 class="h1">{titleText}</h2>
        <p class="p">{subtitleText}</p>
      </>
    )}

    <div class="banner">
      <img src={vacuumBanner} alt="분뇨차 탱크 부품" loading="lazy" />
    </div>

    <div class="grid">
      {vacuumCards.map((c) => (
        <a class="card" href={c.href}>
          <div class="card-title">{c.title}</div>
          <div class="card-desc">{c.desc}</div>
          <div class="card-cta">자세히 보기 →</div>
        </a>
      ))}
    </div>

    <div class="banner">
      <img src={fuelBanner} alt="유조차 탱크 부품" loading="lazy" />
    </div>

    <div class="grid">
      {fuelCards.map((c) => (
        <a class="card" href={c.href}>
          <div class="card-title">{c.title}</div>
          <div class="card-desc">{c.desc}</div>
          <div class="card-cta">자세히 보기 →</div>
        </a>
      ))}
    </div>

    {showLinkPanel && <ProductLinkPanel />}
    
    {showActions && (
      <div class="actions">
        <ContactActions />
      </div>
    )}
    
  </div>

  <style>
    .wrap { padding: 24px 0 10px; }
    .h1 { font-size: 40px; margin: 0 0 6px; font-weight: 900; letter-spacing: -0.03em; }
    .p { margin: 0 0 16px; color: var(--muted); }

    .banner { margin: 18px 0 12px; }
    .banner img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 16px;
      border: 1px solid var(--line);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 50px;
    }

    .card {
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 16px;
      background: #fff;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-height: 120px;
    }

    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    }

    .card-title { font-weight: 900; }
    .card-desc { color: var(--muted); font-size: 14px; line-height: 1.4; }
    .card-cta { margin-top: auto; color: var(--brand); font-weight: 800; }

    .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; }

    @media (max-width: 900px) {
      .grid { grid-template-columns: repeat(2, 1fr); }
      .h1 { font-size: 32px; }
    }

    @media (max-width: 560px) {
      .grid { grid-template-columns: 1fr; }
      .h1 { font-size: 28px; }
    }
  </style>
</section>
