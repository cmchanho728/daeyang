---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<section class="link-panel" aria-label="추가 제품 링크">
  <div class="pair">
    <div class="image-box">
      <img src={`${base}power-trans.jpg`} alt="power-trans" loading="lazy" />
    </div>
    <div class="card-row">
      <a class="link-card" href={`${base}products/etc-joint/`}>
        <div class="card-title">조인트</div>
        <div class="card-desc">분뇨차 조인트/피팅 부품</div>
        <div class="card-cta">자세히 보기 →</div>
      </a>
      <a class="link-card" href={`${base}products/etc-coupling/`}>
        <div class="card-title">커플링</div>
        <div class="card-desc">분뇨차 라인 커플링 부품</div>
        <div class="card-cta">자세히 보기 →</div>
      </a>
    </div>
  </div>

  <div class="pair">
    <div class="image-box">
      <img src={`${base}pipe-joint.jpg`} alt="pipe-joint" loading="lazy" />
    </div>
    <div class="card-row">
      <a class="link-card" href={`${base}products/etc-flange/`}>
        <div class="card-title">플렌지</div>
        <div class="card-desc">유조차 플렌지/연결 부품</div>
        <div class="card-cta">자세히 보기 →</div>
      </a>
      <a class="link-card" href={`${base}products/etc-gasket/`}>
        <div class="card-title">패킹</div>
        <div class="card-desc">유조차 패킹/씰링 부품</div>
        <div class="card-cta">자세히 보기 →</div>
      </a>
    </div>
  </div>
</section>

<style>
  .link-panel {
    margin: 20px 0 8px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .pair {
    display: grid;
    gap: 10px;
  }

  .image-box {
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
  }

  .image-box img {
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    display: block;
  }

  .card-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .link-card {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 16px;
    background: #fff;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 120px;
  }

  .link-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .card-title {
    font-weight: 900;
  }

  .card-desc {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.4;
  }

  .card-cta {
    margin-top: auto;
    color: var(--brand);
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .link-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .card-row {
      grid-template-columns: 1fr;
    }
  }
</style>
