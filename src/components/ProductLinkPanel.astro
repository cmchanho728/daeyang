---
import { categoryMetas } from "../data/products";
import { baseUrl as base } from "../utils/url";

const commonCards = categoryMetas
  .filter((c) => c.published && c.group === "common")
  .sort((a, b) => a.order - b.order)
  .map((c) => ({ title: c.title, desc: c.summary, href: `${base}products/${c.key}/` }));

// 페어당 카드 2개 + 배너 이미지 1장 — 현재 순서(조인트,플랜지 / 호스,커플링)를 그대로 유지.
const pairBanners = [
  { src: `${base}power-trans.jpg`, alt: "조인트·플랜지 부품 이미지" },
  { src: `${base}pipe-joint.jpg`, alt: "호스·커플링 부품 이미지" },
];

const pairs = pairBanners.map((banner, i) => ({
  banner,
  cards: commonCards.slice(i * 2, i * 2 + 2),
}));
---

<section class="link-panel" aria-label="추가 제품 링크">
  {pairs.map((pair) => (
    <div class="pair">
      <div class="image-box">
        <img src={pair.banner.src} alt={pair.banner.alt} loading="lazy" />
      </div>
      <div class="card-row">
        {pair.cards.map((c) => (
          <a class="link-card" href={c.href}>
            <div class="card-title">{c.title}</div>
            <div class="card-desc">{c.desc}</div>
            <div class="card-cta">자세히 보기 →</div>
          </a>
        ))}
      </div>
    </div>
  ))}
</section>

<style>
  .link-panel {
    margin: 20px 0 8px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .pair {
    display: grid;
    gap: 10px;
  }

  .image-box {
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
  }

  .image-box img {
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    display: block;
  }

  .card-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .link-card {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 16px;
    background: #fff;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 120px;
  }

  .link-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .card-title {
    font-weight: 900;
  }

  .card-desc {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.4;
  }

  .card-cta {
    margin-top: auto;
    color: var(--brand);
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .link-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .card-row {
      grid-template-columns: 1fr;
    }
  }
</style>
