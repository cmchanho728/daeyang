---
// filepath: src/components/ProductCategoryPage.astro
// 제품 카테고리 공통 페이지 컴포넌트

import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "./Breadcrumb.astro";
import Lightbox from "./Lightbox.astro";
import ContactActions from "./ContactActions.astro";
import type { CategoryData } from "../data/products";
import { categoryMetas } from "../data/products";
import { site } from "../config/site";
import { baseUrl as base } from "../utils/url";

interface Props {
  category: string;
  data: CategoryData;
}

const { category, data } = Astro.props;

const { pageTitle, pageDescription, products } = data;

// 메타 description은 "대양특장의 {분뇨차/유조차} {카테고리명} — 실제 제품명 3~4개 등. ..." 형식으로 자동 생성
// (본문 pageDescription과는 별개). 차량 구분은 categoryMetas(2-B에서 만든 실제 카드 데이터)에서 가져온다 —
// vacuum/fuel 그룹은 그룹 자체로, common 그룹(조인트/플랜지/호스/커플링)은 각 카테고리의 실제 summary가
// "분뇨차"/"유조차" 중 어느 쪽으로 시작하는지로 판단한다.
const categoryMeta = categoryMetas.find((c) => c.key === category);
const vehicleLabel =
  categoryMeta?.group === "vacuum"
    ? "분뇨차"
    : categoryMeta?.group === "fuel"
      ? "유조차"
      : categoryMeta?.summary.startsWith("유조차")
        ? "유조차"
        : "분뇨차";
const categoryLabel =
  pageTitle.startsWith("분뇨차") || pageTitle.startsWith("유조차")
    ? pageTitle
    : `${vehicleLabel} ${pageTitle}`;

const metaDescription = `${site.shortName}의 ${categoryLabel} — ${products
  .slice(0, 4)
  .map((p) => p.name)
  .join(", ")} 등. 규격·사진·외관도를 확인하고 견적을 문의하세요.`;
const metaOgImage = products[0] ? `${site.siteUrl}${products[0].img}` : undefined;
---

<BaseLayout title={`${pageTitle} | ${site.shortName}`} description={metaDescription} ogImage={metaOgImage}>
  <section class="section">
    <div class="container">
      <Breadcrumb
        compact
        items={[
          { label: "홈", href: base },
          { label: "제품소개", href: `${base}products/` },
          { label: pageTitle },
        ]}
      />

      <h1 class="h1">{pageTitle}</h1>
      <p class="p">{pageDescription}</p>

      <div class="grid">
        {products.map((item) => (
          <a href={`#spec-${item.id}`} class="card">
            <img src={item.img} alt={`${pageTitle} ${item.name}`} loading="lazy" />
            <div class="card-title">{item.name}</div>
          </a>
        ))}
      </div>

      <section class="specs">
        <h2 class="h2">제품 스펙</h2>
        <p class="muted">
          상세 규격은 차량/연식/적용 라인에 따라 달라질 수 있습니다. 정확한 확인은 문의 바랍니다.
        </p>

        {products.map((p) => (
          <div class="spec-card" id={`spec-${p.id}`}>
            <div class="spec-head">
              <h3 class="h3">{p.name}</h3>
            </div>

            <div class="spec-content three-panel">
              <section class="info-panel">
                <h4 class="panel-title">제품스펙</h4>

                <div class="table-wrap">
                  <table class="spec-table">
                    <tbody>
                      {Object.entries(p.specs).map(([k, v]) => (
                        <tr>
                          <th>{k}</th>
                          <td>{v}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </section>

              <section class="info-panel">
                <h4 class="panel-title">제품사진</h4>

                {(p.images && p.images.length > 0) ? (
                  <div class="photo-grid">
                    {p.images.map((img) => (
                      <figure class="spec-photo">
                        <button
                          class="photo-btn"
                          type="button"
                          data-lightbox-src={img.src}
                          data-lightbox-caption={(img.caption ?? img.alt) || `${p.name} 제품사진`}
                        >
                          <span class="product-media-frame">
                            <img src={img.src} alt={img.alt || `${p.name} 제품사진`} loading="lazy" />
                          </span>
                        </button>
                        {img.caption && <p class="product-media-caption">{img.caption}</p>}
                      </figure>
                    ))}
                  </div>
                ) : (
                  <figure class="spec-photo">
                    <button
                      class="photo-btn"
                      type="button"
                      data-lightbox-src={p.img}
                      data-lightbox-caption={`${p.name} 제품사진`}
                    >
                      <span class="product-media-frame">
                        <img src={p.img} alt={`${p.name} 제품사진`} loading="lazy" />
                      </span>
                    </button>
                  </figure>
                )}
              </section>

              <section class="info-panel">
                <h4 class="panel-title">외관도</h4>

                {(p.drawings && p.drawings.length > 0) ? (
                  <div class="photo-grid drawing-grid">
                    {p.drawings.map((img) => (
                      <figure class="spec-photo drawing-photo">
                        <button
                          class="photo-btn"
                          type="button"
                          data-lightbox-src={img.src}
                          data-lightbox-caption={(img.caption ?? img.alt) || `${p.name} 외관도`}
                        >
                          <span class="product-media-frame">
                            <img src={img.src} alt={img.alt || `${p.name} 외관도`} loading="lazy" />
                          </span>
                        </button>
                        {img.caption && <p class="product-media-caption">{img.caption}</p>}
                      </figure>
                    ))}
                  </div>
                ) : p.specImg ? (
                  <figure class="spec-photo drawing-photo">
                    <button
                      class="photo-btn"
                      type="button"
                      data-lightbox-src={p.specImg}
                      data-lightbox-caption={`${p.name} 외관도`}
                    >
                      <span class="product-media-frame">
                        <img src={p.specImg} alt={`${p.name} 외관도`} loading="lazy" />
                      </span>
                    </button>
                  </figure>
                ) : (
                  <div class="no-image">
                    <p>외관도 준비중</p>
                  </div>
                )}
              </section>
            </div>

            <div class="product-inquiry">
              <h4 class="panel-title">이 제품 문의</h4>
              <div class="inquiry-actions">
                <a class="btn ghost" href={site.phone.href}>전화 문의</a>
                <a class="btn kakao" href={site.kakaoUrl} target="_blank" rel="noopener">카카오톡 상담</a>
                <a
                  class="btn ghost"
                  href={`mailto:${site.email}?subject=${encodeURIComponent(`[견적문의] ${categoryLabel} - ${p.name}`)}`}
                >
                  이메일 문의
                </a>
              </div>
              <p class="inquiry-note">카카오톡은 내용이 자동으로 입력되지 않으니 "{p.name}" 제품명을 함께 알려주세요.</p>
            </div>
          </div>
        ))}
      </section>

      <div class="actions">
        <ContactActions />
      </div>
    </div>
  </section>

  <Lightbox ariaLabel="제품 이미지 확대 보기" />

  <style>
    .grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:32px; }
    .card { display:block; text-decoration:none; border-radius:14px; overflow:hidden; background:#fff; box-shadow:0 6px 18px rgba(0,0,0,0.05); transition:0.25s; }
    .card:hover { transform:translateY(-4px); }
    .card img { width:100%; aspect-ratio: 16 / 9; object-fit:cover; display:block; }
    .card-title { padding:16px; text-align:center; font-size:18px; font-weight:600; color:var(--text); }

    .actions { margin-top:40px; display:flex; gap:12px; flex-wrap:wrap; }

    @media (max-width:1024px){ .grid{ grid-template-columns:repeat(2,1fr); } }
    @media (max-width:600px){ .grid{ grid-template-columns:1fr; } }

    .h2{ margin-top:44px; font-size:22px; font-weight:800; }
    .muted{ color:var(--text-3); margin:8px 0 18px; line-height:1.6; }

    .spec-card{ border:1px solid rgba(0,0,0,0.08); border-radius:14px; padding:16px; background:#fff; margin-bottom:14px; scroll-margin-top:90px; }
    .spec-head{ display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin-bottom:10px; }
    .h3{ margin:0; font-size:28px; font-weight:900; }
    
    .spec-content.three-panel{
      display:grid;
      grid-template-columns:2fr 1fr 1fr;
      gap:10px;
      align-items:start;
    }

    .info-panel{
      border:none;
      background:#fff;
      padding:12px;
      min-height:auto;
    }

    .panel-title{
      margin:0 0 12px;
      text-align:center;
      font-size:18px;
      font-weight:800;
      color:var(--text);
      line-height:1.2;
    }

    .info-panel .spec-photo{
      width:100%;
      max-width:230px;
      margin:0 auto;
      display:flex;
      flex-direction:column;
      gap:8px;
      align-items:center;
      padding:0;
      background:transparent;
    }

    .product-media-frame {
      width:100%;
      height:160px;
      border:1px solid rgba(0,0,0,0.12);
      border-radius:12px;
      background:#fff;
      overflow:hidden;
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .product-media-frame img{
      width:100%;
      height:100%;
      object-fit:contain;
      background:#fff;
      display:block;
    }

    .photo-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      width: 100%;
      max-width: 230px;
      margin: 0 auto;
    }

    .photo-grid .spec-photo {
      margin: 0;
      max-width: 100%;
    }

    .drawing-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      width: 100%;
      max-width: 230px;
      margin: 0 auto;
    }

    .photo-btn {
      width:100%;
      height:100%;
      border:0;
      background:transparent;
      padding:0;
      cursor:zoom-in;
      display:block;
    }

    .product-media-caption {
      margin: 6px 0 0;
      font-size: 14px;
      font-weight: 700;
      color: var(--text-2);
      text-align: center;
      line-height: 1.4;
    }

    .drawing-photo img{
      object-fit:contain;
    }

    .no-image {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 160px;
      background: var(--surface);
      border: 1px solid rgba(0,0,0,0.12);
      border-radius: 12px;
      margin: 0;
    }

    .no-image p {
      color: var(--text-3);
      font-size: 14px;
      margin: 0;
    }

    .product-inquiry {
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid rgba(0,0,0,0.08);
    }

    .inquiry-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .inquiry-note {
      margin: 10px 0 0;
      font-size: 14px;
      color: var(--text-3);
    }

    .table-wrap{ overflow-x:auto; }
    .spec-table{ width:100%; border-collapse:collapse; min-width:0; }
    .spec-table th, .spec-table td{ border-top:1px solid rgba(0,0,0,0.08); padding:10px 12px; text-align:left; vertical-align:top; }
    .spec-table th{ width:180px; color:var(--text-2); font-weight:700; background:rgba(0,0,0,0.02); }
    .spec-table td{ color:var(--text); }
    .spec-photo{ margin:0; display:flex; align-items:center; justify-content:center; }
    .photo-btn{ width:100%; height:100%; border:0; background:transparent; padding:0; cursor:zoom-in; display:flex; align-items:center; justify-content:center; }

    @media (max-width:980px){
      .spec-content.three-panel{
        grid-template-columns:1fr;
      }

      .info-panel{
        min-height:auto;
      }

      .info-panel .spec-photo{
        max-width:200px;
        height:140px;
      }

      .photo-grid {
        max-width: 200px;
      }

      .photo-grid .spec-photo {
        height: 140px;
      }

      .drawing-grid {
        max-width: 200px;
      }

      .drawing-grid .spec-photo {
        height: 140px;
      }

      .drawing-photo {
        height:140px;
      }
    }

    @media (max-width:600px){
      .h3{
        font-size:24px;
      }

      .panel-title{
        font-size:17px;
      }

      .info-panel .spec-photo{
        max-width:180px;
        height:120px;
      }

      .photo-grid {
        max-width: 180px;
      }

      .photo-grid .spec-photo {
        height: 120px;
      }

      .drawing-grid {
        max-width: 180px;
      }

      .drawing-grid .spec-photo {
        height: 120px;
      }

      .drawing-photo {
        height:120px;
      }
    }
  </style>
</BaseLayout>