---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { site } from "../../config/site";
import { baseUrl as base } from "../../utils/url";
---

<BaseLayout title={`문의 | ${site.shortName}`}>
  <section class="section">
    <div class="container">
      <Breadcrumb items={[{ label: "홈", href: base }, { label: "문의" }]} />
      <h1 class="h1">문의</h1>
      <p class="p">견적, 납기, 제품 문의는 전화 또는 이메일로 연락 주세요.</p>

      <div class="grid cols-2" style="margin-top:16px;">
        <div class="card">
          <b>연락처</b>
          <div class="p" style="margin-top:6px;">
            전화: <a href={site.phone.href} style="color:var(--brand); font-weight:700;">{site.phone.display}</a><br/>
            이메일: <a href={`mailto:${site.email}`} style="color:var(--brand); font-weight:700;">{site.email}</a><br/>
            카카오톡: <a href={site.kakaoUrl} target="_blank" rel="noopener" style="color:var(--brand); font-weight:700;">상담 바로가기</a>
          </div>
        </div>
        <div class="card">
          <b>문의 방식</b>
          <div class="p" style="margin-top:6px;">카카오톡 상담 또는 전화 문의를 우선 이용해 주세요.</div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
