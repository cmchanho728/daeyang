---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="회사소개 | 대양특장">
  <section class="section">
    <div class="container">
      <h1 class="h1">회사소개</h1>
      <p class="p">대양특장는 산업용 자재·부품을 안정적으로 공급합니다.</p>

      <div class="grid cols-2" style="margin-top:16px;">
        <div class="card"><b>주요 업무</b><div class="p">납품/견적/발주 지원</div></div>
        <div class="card"><b>강점</b><div class="p">빠른 회신 · 납기 준수</div></div>
      </div>
    </div>
  </section>
</BaseLayout>
