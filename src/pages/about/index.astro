---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="회사소개 | 대양특장">
  <section class="section">
    <div class="container">
      <h1 class="h1">회사소개</h1>
      <p class="p">대양특장은 분뇨차·유조차 부품을 안정적으로 공급하는 전문 기업입니다.</p>

      <div class="grid cols-2" style="margin-top:16px;">
        <div class="card">
          <b>주요 업무</b>
          <div class="p">부품 공급, 견적 상담, 납품 및 사후 응대</div>
        </div>
        <div class="card">
          <b>강점</b>
          <div class="p">빠른 대응과 꾸준한 공급 경험</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
