---
import BaseLayout from "../../layouts/BaseLayout.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const patents = [
  { title: "1. 도찰처리용 암롤박스", img: `${base}about-us.jpg` },
  { title: "2. 쓰레기분리수거차량", img: `${base}about-us.jpg` },
];

const certifications = [
  { title: "1. 기술 인증 항목 A", img: `${base}about-us.jpg` },
  { title: "2. 기술 인증 항목 B", img: `${base}about-us.jpg` },
  { title: "3. 기술 인증 항목 C", img: `${base}about-us.jpg` },
  { title: "4. 기술 인증 항목 D", img: `${base}about-us.jpg` },
];
---

<BaseLayout title="기술현황 | 대양특장">
  <section class="section">
    <div class="container">
      <h1 class="h1">기술현황</h1>

      <div class="tabs" role="tablist" aria-label="기술현황 탭">
        <button class="tab is-active" type="button" role="tab" aria-selected="true" data-tab="patent">
          특허
        </button>
        <button class="tab" type="button" role="tab" aria-selected="false" data-tab="cert">
          기술 인증
        </button>
      </div>

      <section class="panel is-active" role="tabpanel" data-panel="patent">
        <div class="grid">
          {patents.map((item) => (
            <figure class="card">
              <button class="image-btn" type="button" data-full={item.img} data-title={item.title}>
                <img src={item.img} alt={`${item.title} 이미지`} loading="lazy" />
              </button>
              <figcaption>{item.title}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="panel" role="tabpanel" data-panel="cert" hidden>
        <div class="grid">
          {certifications.map((item) => (
            <figure class="card">
              <button class="image-btn" type="button" data-full={item.img} data-title={item.title}>
                <img src={item.img} alt={`${item.title} 이미지`} loading="lazy" />
              </button>
              <figcaption>{item.title}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <p class="note">
        각 기술 항목은 이미지 1장씩 등록할 수 있도록 구성되어 있습니다. 이미지 파일만 교체하면 카드에
        바로 반영됩니다.
      </p>
    </div>
  </section>

  <div class="lightbox" data-lightbox hidden>
    <button class="backdrop" type="button" aria-label="닫기" data-close></button>
    <div class="dialog" role="dialog" aria-modal="true" aria-label="이미지 확대 보기">
      <button class="close" type="button" aria-label="닫기" data-close>×</button>
      <img src="" alt="" data-lightbox-image />
      <p class="caption" data-lightbox-caption></p>
    </div>
  </div>

  <script is:inline>
    const tabs = Array.from(document.querySelectorAll("[data-tab]"));
    const panels = Array.from(document.querySelectorAll("[data-panel]"));
    const openButtons = Array.from(document.querySelectorAll("[data-full]"));
    const lightbox = document.querySelector("[data-lightbox]");
    const lightboxImage = document.querySelector("[data-lightbox-image]");
    const lightboxCaption = document.querySelector("[data-lightbox-caption]");
    const closeButtons = Array.from(document.querySelectorAll("[data-close]"));

    const setActive = (target) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.tab === target;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", active ? "true" : "false");
      });

      panels.forEach((panel) => {
        const active = panel.dataset.panel === target;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => setActive(tab.dataset.tab));
    });

    const closeLightbox = () => {
      if (!lightbox || !lightboxImage || !lightboxCaption) return;
      lightbox.hidden = true;
      lightboxImage.setAttribute("src", "");
      lightboxImage.setAttribute("alt", "");
      lightboxCaption.textContent = "";
      document.body.style.overflow = "";
    };

    openButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!lightbox || !lightboxImage || !lightboxCaption) return;
        const src = btn.dataset.full || "";
        const title = btn.dataset.title || "이미지";
        lightboxImage.setAttribute("src", src);
        lightboxImage.setAttribute("alt", title);
        lightboxCaption.textContent = title;
        lightbox.hidden = false;
        document.body.style.overflow = "hidden";
      });
    });

    closeButtons.forEach((btn) => {
      btn.addEventListener("click", closeLightbox);
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && lightbox && !lightbox.hidden) {
        closeLightbox();
      }
    });
  </script>

  <style>
    .tabs {
      display: flex;
      gap: 10px;
      border-bottom: 1px solid var(--line);
      margin-top: 6px;
      margin-bottom: 18px;
    }

    .tab {
      border: 0;
      border-bottom: 3px solid transparent;
      background: transparent;
      color: #9ca3af;
      font-weight: 800;
      font-size: 24px;
      padding: 12px 16px 10px;
      cursor: pointer;
    }

    .tab.is-active {
      color: #0b4ea8;
      border-bottom-color: #0b4ea8;
    }

    .panel {
      display: none;
    }

    .panel.is-active {
      display: block;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 26px;
      align-items: start;
    }

    .card {
      margin: 0;
    }

    .image-btn {
      width: 100%;
      border: 0;
      background: transparent;
      padding: 0;
      cursor: zoom-in;
    }

    .card img {
      width: 100%;
      border: 1px solid #eef2f7;
      background: #fff;
      border-radius: 2px;
      display: block;
      aspect-ratio: 3 / 4;
      object-fit: cover;
    }

    .card figcaption {
      margin-top: 12px;
      font-size: 34px;
      line-height: 1.3;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #2a2a2a;
    }

    .note {
      margin-top: 16px;
      color: var(--muted);
      font-size: 14px;
    }

    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .lightbox[hidden] {
      display: none !important;
    }

    .backdrop {
      position: absolute;
      inset: 0;
      border: 0;
      background: rgba(0, 0, 0, 0.7);
      cursor: pointer;
    }

    .dialog {
      position: relative;
      z-index: 1;
      width: min(100%, 980px);
      max-height: 92vh;
      margin: auto;
      border-radius: 10px;
      background: #fff;
      padding: 14px 14px 8px;
      overflow: auto;
    }

    .dialog img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 8px;
    }

    .close {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 34px;
      height: 34px;
      border: 0;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.65);
      color: #fff;
      font-size: 24px;
      line-height: 1;
      cursor: pointer;
    }

    .caption {
      margin: 10px 0 4px;
      color: #374151;
      font-weight: 700;
    }

    @media (max-width: 1200px) {
      .grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .card figcaption {
        font-size: 26px;
      }
    }

    @media (max-width: 640px) {
      .grid {
        grid-template-columns: 1fr;
      }

      .tab {
        font-size: 20px;
      }

      .card figcaption {
        font-size: 20px;
      }
    }
  </style>
</BaseLayout>
