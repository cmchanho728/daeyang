---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="사업분야 | 대양특장">
  <section class="section">
    <div class="container">
      <h1 class="h1">사업분야</h1>
      <p class="p">취급 품목/서비스를 분야별로 정리합니다.</p>

      <div class="grid cols-3" style="margin-top:16px;">
        <div class="card"><b>분야 1</b><div class="p">설명</div></div>
        <div class="card"><b>분야 2</b><div class="p">설명</div></div>
        <div class="card"><b>분야 3</b><div class="p">설명</div></div>
      </div>
    </div>
  </section>
</BaseLayout>
