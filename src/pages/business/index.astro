---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="사업분야 | 대양특장">
  <section class="section">
    <div class="container">
      <h1 class="h1">사업분야</h1>
      <p class="p">취급 품목과 서비스를 분야별로 안내합니다.</p>

      <div class="grid cols-3" style="margin-top:16px;">
        <div class="card"><b>분뇨차 부품</b><div class="p">펌프, 밸브, 기타 부품</div></div>
        <div class="card"><b>유조차 부품</b><div class="p">펌프, 밸브, 기타 부품</div></div>
        <div class="card"><b>견적/상담</b><div class="p">카카오톡 및 전화 상담</div></div>
      </div>
    </div>
  </section>
</BaseLayout>
