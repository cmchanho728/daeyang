---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Lightbox from "../../components/Lightbox.astro";
import { site } from "../../config/site";
import { baseUrl as base } from "../../utils/url";

const patents = [
  { title: "1. 버큠 로리의 메인 맨홀", img: `${base}business/patent1.jpg` },
  { title: "2. 버큠 로리용 메인 맨홀", img: `${base}business/patent2.jpg` },
];

const certifications = [
  { title: "1. 분뇨차 이방밸브", img: `${base}business/vc-2way-valve.jpg` },
  { title: "2. 유조차 이방밸브", img: `${base}business/tl-2way-valve.jpg` },
  { title: "3. 분뇨차 안전밸브", img: `${base}business/vc-safety-valve.jpg` },
  { title: "4. 유조차 에어벤트", img: `${base}business/tl-safety-valve.jpg` },
  { title: "5. 유조차 바이패스밸브", img: `${base}business/tl-bypass-valve.jpg` },
];
---

<BaseLayout
  title={`기술현황 | ${site.shortName}`}
  description={`${site.shortName}은 버큠로리 메인 맨홀 특허를 보유하고 있으며, 분뇨차·유조차용 이방밸브·안전밸브·에어벤트·바이패스밸브(바이페스밸브) 등에 대한 기술 인증을 획득했습니다.`}
>
  <section class="section">
    <div class="container">
      <Breadcrumb items={[{ label: "홈", href: base }, { label: "기술현황" }]} />
      <h1 class="h1">기술현황</h1>

      <div class="tabs" role="tablist" aria-label="기술현황 탭">
        <button class="tab is-active" type="button" role="tab" aria-selected="true" data-tab="patent">
          특허
        </button>
        <button class="tab" type="button" role="tab" aria-selected="false" data-tab="cert">
          기술 인증
        </button>
      </div>

      <section class="panel is-active" role="tabpanel" data-panel="patent">
        <div class="grid">
          {patents.map((item) => (
            <figure class="card">
              <button class="image-btn" type="button" data-lightbox-src={item.img} data-lightbox-caption={item.title}>
                <img src={item.img} alt={`${item.title} 이미지`} loading="lazy" />
              </button>
              <figcaption>{item.title}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="panel" role="tabpanel" data-panel="cert" hidden>
        <div class="grid">
          {certifications.map((item) => (
            <figure class="card">
              <button class="image-btn" type="button" data-lightbox-src={item.img} data-lightbox-caption={item.title}>
                <img src={item.img} alt={`${item.title} 이미지`} loading="lazy" />
              </button>
              <figcaption>{item.title}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    </div>
  </section>

  <Lightbox />

  <script is:inline>
    const tabs = Array.from(document.querySelectorAll("[data-tab]"));
    const panels = Array.from(document.querySelectorAll("[data-panel]"));

    const setActive = (target) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.tab === target;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", active ? "true" : "false");
      });

      panels.forEach((panel) => {
        const active = panel.dataset.panel === target;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => setActive(tab.dataset.tab));
    });
  </script>

  <style>
    .tabs {
      display: flex;
      gap: 10px;
      border-bottom: 1px solid var(--line);
      margin-top: 6px;
      margin-bottom: 18px;
    }

    .tab {
      border: 0;
      border-bottom: 3px solid transparent;
      background: transparent;
      color: #9ca3af;
      font-weight: 800;
      font-size: 24px;
      padding: 12px 16px 10px;
      cursor: pointer;
    }

    .tab.is-active {
      color: #0b4ea8;
      border-bottom-color: #0b4ea8;
    }

    .panel {
      display: none;
    }

    .panel.is-active {
      display: block;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 26px;
      align-items: start;
    }

    .card {
      margin: 0;
    }

    .image-btn {
      width: 100%;
      border: 0;
      background: transparent;
      padding: 0;
      cursor: zoom-in;
    }

    .card img {
      width: 100%;
      border: 1px solid #eef2f7;
      background: #fff;
      border-radius: 2px;
      display: block;
      aspect-ratio: 3 / 4;
      object-fit: cover;
    }

    .card figcaption {
      margin-top: 12px;
      font-size: 24px;
      line-height: 1.3;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #2a2a2a;
    }

    @media (max-width: 1200px) {
      .grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .card figcaption {
        font-size: 24px;
      }
    }

    @media (max-width: 640px) {
      .grid {
        grid-template-columns: 1fr;
      }

      .tab {
        font-size: 20px;
      }

      .card figcaption {
        font-size: 20px;
      }
    }
  </style>
</BaseLayout>
