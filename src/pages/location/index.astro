---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="오시는길 | 대양특장">
  <section class="section">
    <div class="container">
      <h1 class="h1">오시는길</h1>
      <p class="p">주소와 지도(카카오/네이버)를 넣습니다.</p>

      <div class="grid cols-2" style="margin-top:16px;">
        <div class="card">
          <b>주소</b>
          <div class="p" style="margin-top:6px;">경기도 양주시 남면 은남로 76-4</div>
          <div class="p">주차/방문 안내 문구</div>
        </div>
        <div class="card">
          <b>지도</b>
          <div class="p" style="margin-top:6px;">지도는 다음 단계에서 임베드로 추가</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
