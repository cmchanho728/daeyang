---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="대양특장 | (구) 대양상사 | 분뇨차·유조차 부품 전문">
  <section class="section">
    <div class="container">
      <span class="badge">Vacuum Truck · Fuel Tanker</span>
      <h1 class="h1">대양특장 주식회사</h1>
      <p class="sub">구 대양상사 · 20년 이상 분뇨차·유조차 부품 전문 기업</p>
      <p>
        대양특장은 기존 대양상사가 법인 전환한 회사입니다.
        20년 이상 분뇨차·유조차 부품을 공급해온 전문 기업입니다.
      </p>

      <div style="display:flex; gap:10px; margin-top:16px; flex-wrap:wrap;">
        
        <a class="btn primary" href={`${base}contact/`}>견적 문의</a>
        <a class="btn ghost" href={`${base}catalog.pdf`} target="_blank" rel="noopener">카다로그</a>
        <a class="btn kakao"
          href="https://pf.kakao.com/_bjkAX/chat"
          target="_blank"
          rel="noopener">
          카카오톡 상담
        </a>
        <a class="btn ghost" href="tel:031-858-2277">전화하기</a>
      </div>
    </div>
  </section>

  <section class="main-image-section">
    <div class="container">
      <img src={`${import.meta.env.BASE_URL}main.jpg`} 
          alt="대양특장 메인 이미지" 
          class="main-image" />
    </div>
  </section>

  <section class="products-section">
    <div class="container">

      <h2 class="section-title">
        <a href={`${base}products/`}>제품 안내</a>
      </h2>

      <div class="product-grid">
        <a href={`${base}products/pump-vacuum/`} class="product-box">분뇨차 펌프</a>
        <a href={`${base}products/valve-vacuum/`} class="product-box">분뇨차 밸브</a>
        <a href={`${base}products/etc-vacuum/`} class="product-box">분뇨차 기타 부품</a>
        <a href={`${base}products/pump-fuel/`} class="product-box">유조차 펌프</a>
        <a href={`${base}products/valve-fuel/`} class="product-box">유조차 밸브</a>
        <a href={`${base}products/etc-fuel/`} class="product-box">유조차 기타 부품</a>
      </div>
    </div>
  </section>
</BaseLayout>


