---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="대양특장 | (구) 대양상사 | 분뇨차·유조차 부품 전문">
  <section class="section">
    <div class="container">
      <span class="badge">Vacuum Truck · Fuel Tanker</span>
      <h1 class="h1">대양특장 주식회사</h1>
      <p class="sub">구 대양상사 · 20년 이상 분뇨차·유조차 부품 전문 기업</p>
      <p>
        대양특장은 기존 대양상사가 법인 전환한 회사입니다.
        20년 이상 분뇨차·유조차 부품을 공급해온 전문 기업입니다.
      </p>

      <div style="display:flex; gap:10px; margin-top:16px; flex-wrap:wrap;">
        <a class="btn ghost" href={`${base}catalog.pdf`} target="_blank" rel="noopener">카다로그</a>
        <a class="btn primary" href={`${base}contact/`}>견적 문의</a>
        <a class="btn ghost" href="tel:031-858-2277">전화하기</a>
        <a class="btn kakao"
          href="https://pf.kakao.com/_bjkAX/chat"
          target="_blank"
          rel="noopener">
          카카오톡 상담
        </a>
      </div>
    </div>
  </section>

  <section class="main-image-section">
    <div class="container">
      <img src={`${import.meta.env.BASE_URL}main.jpg`} 
          alt="대양특장 메인 이미지" 
          class="main-image" />
    </div>
  </section>

  <section class="section" style="background:#f8fafc; border-top:1px solid var(--line); border-bottom:1px solid var(--line);">
    <div class="container">
      <h2 style="margin:0 0 10px; font-size:18px; font-weight:900;">주요 서비스</h2>
      <div class="grid cols-3">
        <div class="card"><b>납품/배송</b><div class="p">현장 일정 맞춤 대응</div></div>
        <div class="card"><b>견적/발주</b><div class="p">빠른 견적 회신</div></div>
        <div class="card"><b>사후지원</b><div class="p">지속적인 거래 지원</div></div>
      </div>
    </div>
  </section>
</BaseLayout>


<style>
.btn.kakao{
  background: #FEE500;
  border-color: #FEE500;
  color: #191919;
  font-weight: 700;
}

.btn.kakao:hover{
  filter: brightness(0.95);
}
</style>