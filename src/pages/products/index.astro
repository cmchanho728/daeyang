---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="제품소개 | 대양특장">
  <section class="section">
    <div class="container">
      <h1 class="h1">제품소개</h1>
      <p class="p">제품/품목을 카드 형태로 보여주고, 추후 상세 페이지로 확장합니다.</p>

      <div class="grid cols-3" style="margin-top:16px;">
        <div class="card"><b>제품 A</b><div class="p">요약 설명</div></div>
        <div class="card"><b>제품 B</b><div class="p">요약 설명</div></div>
        <div class="card"><b>제품 C</b><div class="p">요약 설명</div></div>
      </div>
    </div>
  </section>
</BaseLayout>
