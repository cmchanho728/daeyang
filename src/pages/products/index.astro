---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductShowcase from "../../components/ProductShowcase.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<BaseLayout title="제품소개 | 대양특장">
  <section class="section">
    <div class="container">
      <p class="breadcrumb">
        <a href={`${base}`}>홈</a> <span>&gt;</span>
        <strong>제품소개</strong>
      </p>

      <ProductShowcase showTitle={true} showActions={true} />
    </div>
  </section>

  <style>
    .breadcrumb {
      display: flex;
      gap: 8px;
      align-items: center;
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 14px;
      flex-wrap: wrap;
    }

    .breadcrumb a { color: var(--muted); }
    .breadcrumb a:hover { color: var(--text); }
  </style>
</BaseLayout>
