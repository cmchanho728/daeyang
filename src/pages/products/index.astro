---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductShowcase from "../../components/ProductShowcase.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { site } from "../../config/site";
import { baseUrl as base } from "../../utils/url";
---

<BaseLayout title={`제품소개 | ${site.shortName}`}>
  <section class="section">
    <div class="container">
      <Breadcrumb items={[{ label: "홈", href: base }, { label: "제품소개" }]} />

      <ProductShowcase showTitle={true} showActions={true} showLinkPanel={true} />
    </div>
  </section>
</BaseLayout>
