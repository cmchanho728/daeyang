---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const pageTitle = "분뇨차 기타 부품";
const pageDescription = "호스/피팅/게이지/조인트 등 분뇨차 기타 부품 라인업입니다.";

const products = [
  {
    id: "hose",
    name: "호스/피팅 세트",
    img: `${base}products-vctruck.jpg`,
    specs: {
      규격: "확인 필요",
      형식: "확인 필요",
      재질: "확인 필요",
      적용라인: "확인 필요",
      연결방식: "확인 필요",
      구성품: "확인 필요",
      비고: "현장 조건에 따라 상이",
    },
  },
  {
    id: "gauge",
    name: "게이지/센서",
    img: `${base}products-vctruck.jpg`,
    specs: {
      규격: "확인 필요",
      형식: "확인 필요",
      재질: "확인 필요",
      적용라인: "확인 필요",
      연결방식: "확인 필요",
      구성품: "확인 필요",
      비고: "현장 조건에 따라 상이",
    },
  },
  {
    id: "joint",
    name: "조인트/클램프",
    img: `${base}products-vctruck.jpg`,
    specs: {
      규격: "확인 필요",
      형식: "확인 필요",
      재질: "확인 필요",
      적용라인: "확인 필요",
      연결방식: "확인 필요",
      구성품: "확인 필요",
      비고: "현장 조건에 따라 상이",
    },
  },
];
---

<BaseLayout title={`${pageTitle} | 대양특장`}>
  <section class="section">
    <div class="container">
      <p class="breadcrumb">
        <a href={`${base}`}>홈</a> &gt;
        <a href={`${base}products/`}>제품소개</a> &gt;
        <strong>{pageTitle}</strong>
      </p>

      <h1 class="h1">{pageTitle}</h1>
      <p class="p">{pageDescription}</p>

      <div class="grid">
        {products.map((item) => (
          <a href={`#spec-${item.id}`} class="card">
            <img src={item.img} alt={`${pageTitle} ${item.name}`} loading="lazy" />
            <div class="card-title">{item.name}</div>
          </a>
        ))}
      </div>

      <section class="specs">
        <h2 class="h2">제품 스펙</h2>
        <p class="muted">
          상세 규격은 차량/연식/적용 라인에 따라 달라질 수 있습니다. 정확한 확인은 문의 바랍니다.
        </p>

        {products.map((p) => (
          <div class="spec-card" id={`spec-${p.id}`}>
            <div class="spec-head">
              <h3 class="h3">{p.name} 스펙</h3>
            </div>

            <div class="spec-content">
              <div class="table-wrap">
                <table class="spec-table">
                  <tbody>
                    {Object.entries(p.specs).map(([k, v]) => (
                      <tr>
                        <th>{k}</th>
                        <td>{v}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <figure class="spec-photo">
                <img src={p.img} alt={`${p.name} 외관`} loading="lazy" />
              </figure>
            </div>
          </div>
        ))}
      </section>

      <div class="actions">
        <a class="btn primary" href={`${base}contact/`}>견적 문의</a>
        <a class="btn ghost" href={`${base}catalog.pdf`} target="_blank" rel="noopener">카다로그</a>
        <a class="btn kakao" href="https://pf.kakao.com/_bjkAX/chat" target="_blank" rel="noopener">카카오톡 상담</a>
        <a class="btn ghost" href="tel:031-858-2277">전화하기</a>
      </div>
    </div>
  </section>

  <style>
    .breadcrumb { font-size:14px; margin-bottom:12px; color:#666; }
    .grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:32px; }
    .card { display:block; text-decoration:none; border-radius:14px; overflow:hidden; background:#fff; box-shadow:0 6px 18px rgba(0,0,0,0.05); transition:0.25s; }
    .card:hover { transform:translateY(-4px); }
    .card img { width:100%; height:260px; object-fit:cover; display:block; }
    .card-title { padding:16px; text-align:center; font-size:18px; font-weight:600; color:#1f2a37; }

    .actions { margin-top:40px; display:flex; gap:12px; flex-wrap:wrap; }

    @media (max-width:1024px){ .grid{ grid-template-columns:repeat(2,1fr); } }
    @media (max-width:600px){ .grid{ grid-template-columns:1fr; } }

    .h2{ margin-top:44px; font-size:22px; font-weight:800; }
    .muted{ color:#6b7280; margin:8px 0 18px; line-height:1.6; }

    .spec-card{ border:1px solid rgba(0,0,0,0.08); border-radius:14px; padding:16px; background:#fff; margin-bottom:14px; scroll-margin-top:90px; }
    .spec-head{ display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin-bottom:10px; }
    .h3{ margin:0; font-size:18px; font-weight:800; }

    .spec-content{ display:grid; grid-template-columns:minmax(0,1fr) 360px; gap:16px; align-items:start; }
    .table-wrap{ overflow-x:auto; }
    .spec-table{ width:100%; border-collapse:collapse; min-width:0; }
    .spec-table th, .spec-table td{ border-top:1px solid rgba(0,0,0,0.08); padding:10px 12px; text-align:left; vertical-align:top; }
    .spec-table th{ width:180px; color:#374151; font-weight:700; background:rgba(0,0,0,0.02); }
    .spec-table td{ color:#111827; }
    .spec-photo{ margin:0; border:1px solid rgba(0,0,0,0.1); border-radius:12px; overflow:hidden; background:#fff; }
    .spec-photo img{ width:100%; aspect-ratio:4/3; object-fit:cover; display:block; }

    @media (max-width:980px){ .spec-content{ grid-template-columns:1fr; } }
  </style>
</BaseLayout>
