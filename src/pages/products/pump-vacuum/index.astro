---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const products = [
  { name: "10L", img: `${base}products/pump-vacuum-10l.jpg`, link: "#" },
  { name: "8L", img: `${base}products/pump-vacuum-8l.jpg`, link: "#" },
  { name: "5L", img: `${base}products/pump-vacuum-5l.jpg`, link: "#" },
  { name: "3L", img: `${base}products/pump-vacuum-3l.jpg`, link: "#" },
];
---

<BaseLayout title="분뇨차 펌프 | 대양특장">
  <section class="section">
    <div class="container">

      <!-- 🔹 Breadcrumb -->
      <p class="breadcrumb">
        <a href={`${base}`}>홈</a> &gt;
        <a href={`${base}products/`}>제품소개</a> &gt;
        <strong>분뇨차 펌프</strong>
      </p>

      <!-- 🔹 타이틀 -->
      <h1 class="h1">분뇨차 펌프</h1>
      <p class="p">
        분뇨차용 진공 펌프 제품 라인업입니다.  
        규격에 맞는 제품 상담 및 견적 문의 가능합니다.
      </p>

      <!-- 🔹 제품 그리드 -->
      <div class="grid">
        {products.map(item => (
          <a href={item.link} class="card">
            <img src={item.img} alt={`분뇨차 펌프 ${item.name}`} />
            <div class="card-title">{item.name}</div>
          </a>
        ))}
      </div>

      <!-- 🔹 하단 버튼 -->
      <div class="actions">
        <a class="btn primary" href={`${base}contact/`}>견적 문의</a>
        <a class="btn ghost" href="tel:031-858-2276">전화하기</a>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
.breadcrumb {
  font-size: 14px;
  margin-bottom: 12px;
  color: #666;
}

.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-top: 32px;
}

.card {
  display: block;
  text-decoration: none;
  border-radius: 14px;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 6px 18px rgba(0,0,0,0.05);
  transition: 0.25s;
}

.card:hover {
  transform: translateY(-4px);
}

.card img {
  width: 100%;
  height: 260px;
  object-fit: cover;
  display: block;
}

.card-title {
  padding: 16px;
  text-align: center;
  font-size: 18px;
  font-weight: 600;
  color: #1f2a37;
}

.actions {
  margin-top: 40px;
  display: flex;
  gap: 12px;
}

@media (max-width: 1024px) {
  .grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .grid {
    grid-template-columns: 1fr;
  }
}
</style>
