---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const pageTitle = "분뇨차 밸브";
const pageDescription = "체크/차단/안전 밸브 등 분뇨차용 밸브 제품 라인업입니다.";

const products = [
  {
    id: "shutoff",
    name: "사방밸브",
    img: `${base}products/valve/valve-vc-4way.jpg`,
    cardImg: `${base}products/valve/valve-vc-4way.jpg`,
    specImg: `${base}products/valve/valve-vc-4way-outer.jpg`,
    specs: {
      모델명: "분뇨차 용 사방밸브",
      규격: "65A  ||  50A  ||  80A 별도 문의",
      형식: "65A: 원형, 사각  ||  50A: 사각",
      재질: "65A: SUS, FC  ||  50A: FC",      
      무게: "65A: 16.9Kg  ||  50A: 9.5Kg",
      조작방식: "수동 레버",
      비고: "탱크 내부 공기를 흡입, 배출, 대기압 모드로 조작합니다.",
    },
  },
  {
    id: "safety",
    name: "이방밸브",
    img: `${base}products/valve/valve-vc-2way.jpg`,
    cardImg: `${base}products/valve/valve-vc-2way.jpg`,
    specImg: `${base}products/valve/valve-vc-2way-outer.jpg`,
    specs: {
      모델명: "분뇨차 용 이방밸브",
      규격: "80A  ||  65A",
      형식: "80A: 커플링, 나사  ||  65A: 커플링, 호수꽂이",
      재질: "80A: FC (볼: SUS)  ||  65A: FC (볼: SUS)",
      무게: "80A: 9.2Kg  ||  65A: 9.1Kg",
      조작방식: "수동 레버",
      비고: "탱크 내부를 외부와 연결 및 차단 합니다. 스텐레스 볼로 마모 및 부식을 방지하였습니다.",
    },
  },  
  {
    id: "check",
    name: "체크밸브",
    img: `${base}products/valve/valve-vc-check.jpg`,
    cardImg: `${base}products/valve/valve-vc-check.jpg`,
    specImg: `${base}products/valve/valve-vc-check.jpg`,
    specs: {
      모델명: "분뇨차 용 체크밸브",
      규격: "80M  ||  50M",
      형식: "80M: 인라인 스프링  ||  50M: 인라인 스프링",
      재질: "80M: FC  ||  50M: FC",
      무게: "80A: 4.7Kg  ||  50A: 2.7Kg",      
      비고: "펌프에 의해 발생한 기체의 압력 차이와 스프링의 힘을 이용해 자동으로 작동 공기의 역류를 방지합니다.",
    },
  },
  
  
];
---

<BaseLayout title={`${pageTitle} | 대양특장`}>
  <section class="section">
    <div class="container">
      <p class="breadcrumb">
        <a href={`${base}`}>홈</a> &gt;
        <a href={`${base}products/`}>제품소개</a> &gt;
        <strong>{pageTitle}</strong>
      </p>

      <h1 class="h1">{pageTitle}</h1>
      <p class="p">{pageDescription}</p>

      <div class="grid">
        {products.map((item) => (
          <a href={`#spec-${item.id}`} class="card">
            <img src={item.cardImg ?? item.img} alt={`${pageTitle} ${item.name}`} loading="lazy" />
            <div class="card-title">{item.name}</div>
          </a>
        ))}
      </div>

      <section class="specs">
        <h2 class="h2">제품 스펙</h2>
        <p class="muted">
          상세 규격은 차량/연식/적용 라인에 따라 달라질 수 있습니다. 정확한 확인은 문의 바랍니다.
        </p>

        {products.map((p) => (
          <div class="spec-card" id={`spec-${p.id}`}>
            <div class="spec-head">
              <h3 class="h3">{p.name}</h3>
            </div>

            <div class="spec-content">
              <div class="table-wrap">
                <table class="spec-table">
                  <tbody>
                    {Object.entries(p.specs).map(([k, v]) => (
                      <tr>
                        <th>{k}</th>
                        <td>{v}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <figure class="spec-photo">
                <button class="photo-btn" type="button" data-spec-photo={p.specImg ?? p.img} data-spec-title={`${p.name} 외관`}>
                  <img src={p.specImg ?? p.img} alt={`${p.name} 외관`} loading="lazy" />
                </button>
              </figure>
            </div>
          </div>
        ))}
      </section>

      <div class="actions">
        <a class="btn primary" href={`${base}contact/`}>견적 문의</a>
        <a class="btn ghost" href={`${base}catalog/`}>카다로그</a>
        <a class="btn kakao" href="https://pf.kakao.com/_bjkAX/chat" target="_blank" rel="noopener">카카오톡 상담</a>
        <a class="btn ghost" href="tel:031-858-2277">전화하기</a>
      </div>
    </div>
  </section>

  <div class="lightbox" data-lightbox hidden>
    <button class="backdrop" type="button" aria-label="닫기" data-close-lightbox></button>
    <div class="dialog" role="dialog" aria-modal="true" aria-label="제품 이미지 확대 보기">
      <button class="close" type="button" aria-label="닫기" data-close-lightbox>×</button>
      <img src="" alt="" data-lightbox-image />
      <p class="caption" data-lightbox-caption></p>
    </div>
  </div>

  <script is:inline>
    const lightbox = document.querySelector("[data-lightbox]");
    const lightboxImage = document.querySelector("[data-lightbox-image]");
    const lightboxCaption = document.querySelector("[data-lightbox-caption]");
    const openButtons = Array.from(document.querySelectorAll("[data-spec-photo]"));
    const closeButtons = Array.from(document.querySelectorAll("[data-close-lightbox]"));

    const closeLightbox = () => {
      if (!lightbox || !lightboxImage || !lightboxCaption) return;
      lightbox.hidden = true;
      lightboxImage.setAttribute("src", "");
      lightboxImage.setAttribute("alt", "");
      lightboxCaption.textContent = "";
      document.body.style.overflow = "";
    };

    openButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!lightbox || !lightboxImage || !lightboxCaption) return;
        const src = btn.dataset.specPhoto || "";
        const title = btn.dataset.specTitle || "제품 이미지";
        lightboxImage.setAttribute("src", src);
        lightboxImage.setAttribute("alt", title);
        lightboxCaption.textContent = title;
        lightbox.hidden = false;
        document.body.style.overflow = "hidden";
      });
    });

    closeButtons.forEach((btn) => {
      btn.addEventListener("click", closeLightbox);
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && lightbox && !lightbox.hidden) closeLightbox();
    });
  </script>

  <style>
    .breadcrumb { font-size:14px; margin-bottom:12px; color:#666; }
    .grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:32px; }
    .card { display:block; text-decoration:none; border-radius:14px; overflow:hidden; background:#fff; box-shadow:0 6px 18px rgba(0,0,0,0.05); transition:0.25s; }
    .card:hover { transform:translateY(-4px); }
    .card img { width:100%; aspect-ratio: 16 / 9; object-fit:cover; display:block; }
    .card-title { padding:16px; text-align:center; font-size:18px; font-weight:600; color:#1f2a37; }

    .actions { margin-top:40px; display:flex; gap:12px; flex-wrap:wrap; }

    @media (max-width:1024px){ .grid{ grid-template-columns:repeat(2,1fr); } }
    @media (max-width:600px){ .grid{ grid-template-columns:1fr; } }

    .h2{ margin-top:44px; font-size:22px; font-weight:800; }
    .muted{ color:#6b7280; margin:8px 0 18px; line-height:1.6; }

    .spec-card{ border:1px solid rgba(0,0,0,0.08); border-radius:14px; padding:16px; background:#fff; margin-bottom:14px; scroll-margin-top:90px; }
    .spec-head{ display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin-bottom:10px; }
    .h3{ margin:0; font-size:18px; font-weight:800; }

    .spec-content{ display:grid; grid-template-columns:minmax(0,1fr) 360px; gap:16px; align-items:start; }
    .table-wrap{ overflow-x:auto; }
    .spec-table{ width:100%; border-collapse:collapse; min-width:0; }
    .spec-table th, .spec-table td{ border-top:1px solid rgba(0,0,0,0.08); padding:10px 12px; text-align:left; vertical-align:top; }
    .spec-table th{ width:180px; color:#374151; font-weight:700; background:rgba(0,0,0,0.02); }
    .spec-table td{ color:#111827; }
    .spec-photo{ margin:0; border:1px solid rgba(0,0,0,0.1); border-radius:12px; overflow:hidden; background:#fff; }
    .photo-btn{ width:100%; border:0; background:transparent; padding:0; cursor:zoom-in; display:block; }
    .spec-photo img{ width:100%; aspect-ratio:4/3; object-fit:cover; display:block; }

    .lightbox{ position:fixed; inset:0; z-index:9999; display:flex; align-items:center; justify-content:center; padding:20px; }
    .lightbox[hidden]{ display:none !important; }
    .backdrop{ position:absolute; inset:0; border:0; background:rgba(0,0,0,0.7); cursor:pointer; }
    .dialog{ position:relative; z-index:1; width:min(100%, 980px); max-height:92vh; margin:auto; border-radius:10px; background:#fff; padding:14px 14px 8px; overflow:auto; }
    .dialog img{ width:100%; height:auto; display:block; border-radius:8px; }
    .close{ position:absolute; top:10px; right:10px; width:34px; height:34px; border:0; border-radius:999px; background:rgba(0,0,0,0.65); color:#fff; font-size:24px; line-height:1; cursor:pointer; }
    .caption{ margin:10px 0 4px; color:#374151; font-weight:700; }

    @media (max-width:980px){ .spec-content{ grid-template-columns:1fr; } }
  </style>
</BaseLayout>

