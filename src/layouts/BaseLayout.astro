---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";

const {
  title = `${site.shortName} | (구) ${site.formerName} | 분뇨차·유조차 부품 전문`,
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <meta
      name="description"
      content={`${site.shortName}은 기존 ${site.formerName}가 법인 전환한 회사로, 분뇨차·유조차 부품을 20년 이상 공급해온 전문 기업입니다.`}
    />

    <meta property="og:title" content={`${site.shortName} | (구) ${site.formerName} | 분뇨차·유조차 부품 전문`} />
    <meta
      property="og:description"
      content={`분뇨차·유조차 부품 전문 기업 ${site.shortName}. 펌프, 밸브, 기타 부품 상담 및 견적 문의 가능.`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site.siteUrl} />
    <meta property="og:image" content={`${site.siteUrl}/main.jpg`} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="robots" content="index, follow" />
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
